# Wrangler configuration TEMPLATE for braincrawl-worker (doc02.02.00).
# The real config is apps/worker/wrangler.toml (gitignored — it carries the
# account's concrete D1/KV IDs). Bootstrap: cp wrangler.toml.example wrangler.toml
# and fill the placeholder IDs after `wrangler d1 create` / `kv namespace create`.
# Local-only flows (wrangler dev --local, conformance) work with placeholders as-is.

name = "braincrawl-worker"
main = "build/worker/shim.mjs"
compatibility_date = "2024-01-01"

[build]
command = "cargo install -q worker-build && worker-build --release"

[[r2_buckets]]
binding = "BLOB_BUCKET"
bucket_name = "braincrawl-blobs"
# preview_bucket_name = "braincrawl-blobs-preview"   # fill for wrangler dev

[[d1_databases]]
binding = "DB"
database_name = "braincrawl-db"
database_id = "placeholder-fill-at-deploy"
migrations_dir = "../../migrations"

[[kv_namespaces]]
binding = "ID_RESOLVER_KV"
id = "placeholder-fill-at-deploy"
# preview_id = "placeholder-fill-for-dev"   # fill for wrangler dev

# AUTH_KV: declared intent for a future multi-token allowlist (SHA-256(token) → {tenant,status}).
# Not wired in this task; the current gate uses the AUTH_TOKEN shared secret only.
# Provision the shared secret via: wrangler secret put AUTH_TOKEN
[[kv_namespaces]]
binding = "AUTH_KV"
id = "placeholder-fill-at-deploy"

[durable_objects]
bindings = [
  { name = "WORK_DO", class_name = "WorkDurableObject" }
]

[[migrations]]
tag = "v1"
new_classes = ["WorkDurableObject"]
