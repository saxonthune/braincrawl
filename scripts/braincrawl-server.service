[Unit]
Description=braincrawl shared local L1/L2 server
Documentation=https://github.com/saxonthune/braincrawl
After=network.target

[Service]
# ExecStart is filled in with this repo's release binary path by `just server-install`.
ExecStart=@EXEC@
Environment=BRAINCRAWL_AUTH_DISABLED=1
Environment=BRAINCRAWL_BIND=127.0.0.1:8787
Environment=BRAINCRAWL_DB=%h/.local/share/braincrawl/braincrawl.db
Environment=BRAINCRAWL_BLOB_ROOT=%h/.local/share/braincrawl/blobs
Environment=BRAINCRAWL_L3_ROOT=%h/.local/share/braincrawl/l3
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
