# braincrawl-server — personal, per-machine overrides.
#
# Copy to ~/.config/braincrawl/server.env (`just systemd-install` does this for
# you if it is absent) and uncomment what you want to change. This file is read
# AFTER the defaults baked into the unit, so anything set here wins. Plain
# KEY=value lines, no quotes, no `export`. Values are literal — systemd does NOT
# expand ~, $HOME, or %h here, so write absolute paths.

# Where the L3 research corpus lives. The unit defaults to
# ~/.local/share/braincrawl/l3; point it at your working corpus instead.
#BRAINCRAWL_L3_ROOT=/home/you/code/github/saxonthune/braincrawl-l3

# Require a bearer token instead of the unit's dev default (auth disabled).
#BRAINCRAWL_AUTH_DISABLED=
#BRAINCRAWL_AUTH_TOKEN=change-me

# Bind address / port.
#BRAINCRAWL_BIND=127.0.0.1:8787

# OpenRouter key for the /api/llm/* proxy, so chat proxy mode (empty API-key
# field in the PWA) works against this server too. Unset → the proxy answers
# 503 and browsers must bring their own key.
#OPENROUTER_API_KEY=sk-or-...
